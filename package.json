{
  "name": "hack-engine-extension",
  "version": "1.3.5",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-release.mjs",
    "build:source": "npm run build && node scripts/build-source.mjs",
    "check": "node scripts/validate-release.mjs",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --warnings-as-errors",
    "test:browser": "node test/run-browser-harnesses.mjs",
    "test:firefox": "node test/run-firefox-extension-harness.mjs",
    "test:chrome": "node test/run-chrome-extension-harness.mjs",
    "release:verify": "npm run build:source && npm run check && npm run lint:firefox && npm run test:unit && npm run test:regression && npm run test:games -- --mode local --no-build --strict",
    "test:unit": "node --test --test-isolation=none test/*.test.mjs",
    "test:games": "node test/run-games.mjs",
    "test:regression": "node test/run-regressions.mjs",
    "test:compatibility": "npm run test:games -- --mode website --strict"
  },
  "devDependencies": {
    "tesseract.js": "7.0.0",
    "web-ext": "10.6.0"
  }
}
